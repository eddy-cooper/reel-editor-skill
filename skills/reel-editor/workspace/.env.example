# Site to record screen clips from (scripts/login.mjs, scripts/capture.mjs).
# Use a dedicated test account: captures change its saved state.
SITE_URL=https://vcehub.com.au
SITE_LOGIN_PATH=/login
SITE_EMAIL=
SITE_PASSWORD=

# Sound effects (scripts/sfx.py).
ELEVENLABS_API_KEY=

# Optional: a browser for Remotion if renders hang on "Waiting for root component".
# REMOTION_BROWSER=/path/to/ms-playwright/chromium_headless_shell-XXXX/chrome-mac/headless_shell
